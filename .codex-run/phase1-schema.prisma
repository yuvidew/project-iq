// ==============================
// Prisma Generator & Datasource
// ==============================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// User & Auth Models
// ==============================

model User {
  id                       String        @id @default(cuid())
  email                    String        @unique
  name                     String?
  image                    String?
  emailVerified            Boolean       @default(false)
  lastActiveOrganizationId Int?
  lastActiveOrganization   Organization? @relation("LastActiveOrganization", fields: [lastActiveOrganizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions             Session[]
  accounts             Account[]
  memberships          OrganizationMember[]
  ownedOrganizations   Organization[]       @relation("OrganizationOwner")
  projectMemberships   ProjectMember[]
  projectLeadProjects  Project[]            @relation("ProjectLead")
  assignedTasks        Task[]               @relation("TaskAssignee")
  taskMemberships      TaskMember[]         @relation("TaskMemberUser")
  taskComments         TaskComment[]        @relation("TaskCommentAuthor")
  chatSessions         ChatSession[]
  semanticCacheEntries SemanticCacheEntry[]

  invites       Invitation[]   @relation("InvitedUser")
  sentInvites   Invitation[]   @relation("SentInvites")
  notifications Notification[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id @default(cuid())
  accountId  String
  providerId String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Also update OrganizationMember.userId (and any other FK to User) to String.

// ==============================
// Organization Models
// ==============================

model Organization {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  // ✅ description added (optional)
  description String?

  logoUrl String?
  ownerId String
  owner   User    @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ inverse relation for last active org
  lastActiveUsers User[] @relation("LastActiveOrganization")

  members  OrganizationMember[]
  projects Project[]
  invites  Invitation[]

  @@map("organization")
}

model OrganizationMember {
  id               Int    @id @default(autoincrement())
  userId           String
  organizationSlug String

  role OrganizationRole @default(MEMBER)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, organizationSlug])
  @@index([organizationSlug])
  @@map("organization_member")
}

// ==============================
// Project Models
// ==============================

model Project {
  id String @id @default(cuid())

  name        String
  description String?

  documents ProjectDocument[]

  status   ProjectStatus   @default(PLANNING)
  priority ProjectPriority @default(MEDIUM)

  startDate DateTime?
  endDate   DateTime?

  organizationSlug String
  organization     Organization @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)

  projectLeadEmail String?
  projectLead      User?   @relation("ProjectLead", fields: [projectLeadEmail], references: [email])

  members              ProjectMember[]
  tasks                Task[]
  chatSessions         ChatSession[]
  knowledgeSources     KnowledgeSource[]
  knowledgeChunks      KnowledgeChunk[]
  knowledgeEmbeddings  KnowledgeEmbedding[]
  semanticCacheEntries SemanticCacheEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationSlug])
  @@map("project")
}

model ProjectDocument {
  id String @id @default(cuid())

  name     String
  document String // URL / text / path

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("project_document")
}

model ProjectMember {
  id Int @id @default(autoincrement())

  projectId String
  userId    String

  role ProjectMemberRole @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_member")
}

// ==============================
// Task Models
// ==============================
model Task {
  id          String     @id @default(cuid())
  name        String
  description String?
  status      TaskStatus @default(TODO)
  position    Int        @default(0) // order within a status column
  dueDate     DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String
  assignee   User?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  members  TaskMember[]
  comments TaskComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, status, position], name: "task_column_order")
  @@index([projectId, status])
}

model TaskMember {
  id     Int    @id @default(autoincrement())
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskComment {
  id       String            @id @default(cuid())
  taskId   String
  authorId String
  content  String
  source   TaskCommentSource @default(MANUAL)

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("task_comment")
}

// ==============================
// Assistant Chat & RAG Models
// ==============================

model ChatSession {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  title     String?

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, userId, updatedAt])
  @@index([userId])
  @@map("chat_session")
}

model ChatMessage {
  id           String                @id @default(cuid())
  sessionId    String
  role         ChatMessageRole
  content      String
  responseType AssistantResponseType @default(TEXT)
  metadata     Json?

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_message")
}

model KnowledgeSource {
  id          String              @id @default(cuid())
  projectId   String
  type        KnowledgeSourceType
  sourceId    String
  title       String?
  contentHash String?
  metadata    Json?

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks  KnowledgeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, type, sourceId])
  @@index([projectId, type])
  @@map("knowledge_source")
}

model KnowledgeChunk {
  id         String @id @default(cuid())
  sourceId   String
  projectId  String
  chunkIndex Int
  content    String
  tokenCount Int?
  metadata   Json?

  source     KnowledgeSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  embeddings KnowledgeEmbedding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, chunkIndex])
  @@index([projectId])
  @@map("knowledge_chunk")
}

model KnowledgeEmbedding {
  id         String                      @id @default(cuid())
  chunkId    String
  projectId  String
  provider   String
  model      String
  dimensions Int                         @default(768)
  embedding  Unsupported("vector(768)")?

  chunk   KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([chunkId, provider, model])
  @@index([projectId, provider, model])
  @@map("knowledge_embedding")
}

model SemanticCacheEntry {
  id                 String                      @id @default(cuid())
  projectId          String
  userId             String?
  question           String
  normalizedQuestion String
  questionHash       String
  answer             String
  responseType       AssistantResponseType       @default(TEXT)
  responsePayload    Json?
  provider           String
  model              String
  dimensions         Int                         @default(768)
  embedding          Unsupported("vector(768)")?
  expiresAt          DateTime?
  hitCount           Int                         @default(0)
  lastHitAt          DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, questionHash, model])
  @@index([projectId, userId])
  @@index([expiresAt])
  @@map("semantic_cache_entry")
}

// ==============================
// Invitation Models
// ==============================

model Invitation {
  id    String           @id @default(cuid())
  email String
  role  OrganizationRole
  token String           @unique

  status InvitationStatus @default(PENDING)

  expiresAt  DateTime
  acceptedAt DateTime?

  organizationSlug String
  teamId           String?
  invitedById      String
  invitedUserId    String?

  organization Organization @relation(fields: [organizationSlug], references: [slug])

  invitedBy   User  @relation("SentInvites", fields: [invitedById], references: [id])
  invitedUser User? @relation("InvitedUser", fields: [invitedUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, organizationSlug])
}

// ==============================
// Notification Models
// ==============================

model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType
  data   Json
  read   Boolean          @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ==============================
// Enums
// ==============================

enum NotificationType {
  INVITATION
}

enum TaskCommentSource {
  MANUAL
  CHAT
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AssistantResponseType {
  TEXT
  TASK_TABLE
  SUMMARY_CARDS
  PROGRESS_CHART
  ACTION_CONFIRMATION
  ERROR
}

enum KnowledgeSourceType {
  PROJECT
  TASK
  TASK_COMMENT
  DOCUMENT
  CHAT_MESSAGE
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ACTIVE
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectMemberRole {
  LEAD
  MEMBER
}

enum TaskStatus {
  BACKLOG
  IN_REVIEW
  TODO
  IN_PROGRESS
  DONE
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}
